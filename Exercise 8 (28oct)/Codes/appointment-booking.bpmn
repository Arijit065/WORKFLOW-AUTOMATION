<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_AppointmentBooking"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler" exporterVersion="5.0.0"
                  modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:message id="Message_Cancel" name="cancel-booking">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=patientId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:process id="appointment-booking" name="Appointment Booking" isExecutable="true">
    <bpmn:documentation>Start variables: patientId, patientName, department, preferredSlot, bookedCount, telegramChatId</bpmn:documentation>

    <bpmn:startEvent id="Start_BookingRequested" name="Booking requested">
      <bpmn:outgoing>Flow_ToCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:businessRuleTask id="Task_CheckSlot" name="Check slot">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="slot_decision" resultVariable="slotResult" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="Gateway_SlotStatus" name="Slot status?">
      <bpmn:incoming>Flow_ToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Available</bpmn:outgoing>
      <bpmn:outgoing>Flow_Full</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:scriptTask id="Task_BookSlot" name="Book slot">
      <bpmn:extensionElements>
        <zeebe:script expression="={bookingId: &#34;BK-&#34; + patientId, department: department, slot: preferredSlot, status: &#34;BOOKED&#34;}" resultVariable="booking" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Available</bpmn:incoming>
      <bpmn:outgoing>Flow_ToConfirm</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:callActivity id="Call_SendConfirmation" name="Send confirmation">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="send-notification" propagateAllParentVariables="false" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=telegramChatId" target="recipientId" />
          <zeebe:input source="=&#34;Hello &#34; + patientName + &#34;, your &#34; + department + &#34; appointment on &#34; + preferredSlot + &#34; is confirmed. Booking ID: &#34; + booking.bookingId" target="messageText" />
          <zeebe:output source="=telegramResponse.status" target="confirmationHttpStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToConfirm</bpmn:incoming>
      <bpmn:outgoing>Flow_ToWait</bpmn:outgoing>
    </bpmn:callActivity>

    <bpmn:intermediateCatchEvent id="Timer_WaitAppointment" name="Wait until appointment">
      <bpmn:incoming>Flow_ToWait</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCompleted</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Wait">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">PT10M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="End_Completed" name="Appointment completed">
      <bpmn:incoming>Flow_ToCompleted</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:callActivity id="Call_SendSlotFull" name="Send slot-full notice">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="send-notification" propagateAllParentVariables="false" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=telegramChatId" target="recipientId" />
          <zeebe:input source="=&#34;Sorry &#34; + patientName + &#34;, &#34; + department + &#34; is fully booked for &#34; + preferredSlot + &#34;. Suggestion: &#34; + slotResult.suggestedAction" target="messageText" />
          <zeebe:output source="=telegramResponse.status" target="slotFullHttpStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Full</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRejected</bpmn:outgoing>
    </bpmn:callActivity>

    <bpmn:endEvent id="End_Rejected" name="Booking rejected (slot full)">
      <bpmn:incoming>Flow_ToRejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:subProcess id="EventSub_HandleCancellation" name="Handle cancellation" triggeredByEvent="true">
      <bpmn:startEvent id="Start_CancelReceived" name="Cancellation received" isInterrupting="true">
        <bpmn:outgoing>Flow_ToRelease</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MsgDef_Cancel" messageRef="Message_Cancel" />
      </bpmn:startEvent>
      <bpmn:scriptTask id="Task_ReleaseSlot" name="Release slot">
        <bpmn:extensionElements>
          <zeebe:script expression="={department: department, slot: preferredSlot, status: &#34;RELEASED&#34;}" resultVariable="slotRelease" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_ToRelease</bpmn:incoming>
        <bpmn:outgoing>Flow_ToCancelNotify</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:callActivity id="Call_SendCancellation" name="Send cancellation notice">
        <bpmn:extensionElements>
          <zeebe:calledElement processId="send-notification" propagateAllParentVariables="false" propagateAllChildVariables="false" />
          <zeebe:ioMapping>
            <zeebe:input source="=telegramChatId" target="recipientId" />
            <zeebe:input source="=&#34;Hi &#34; + patientName + &#34;, your &#34; + department + &#34; appointment on &#34; + preferredSlot + &#34; has been cancelled and the slot released.&#34;" target="messageText" />
            <zeebe:output source="=telegramResponse.status" target="cancellationHttpStatus" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_ToCancelNotify</bpmn:incoming>
        <bpmn:outgoing>Flow_ToCancelled</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:endEvent id="End_Cancelled" name="Booking cancelled">
        <bpmn:incoming>Flow_ToCancelled</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_ToRelease" sourceRef="Start_CancelReceived" targetRef="Task_ReleaseSlot" />
      <bpmn:sequenceFlow id="Flow_ToCancelNotify" sourceRef="Task_ReleaseSlot" targetRef="Call_SendCancellation" />
      <bpmn:sequenceFlow id="Flow_ToCancelled" sourceRef="Call_SendCancellation" targetRef="End_Cancelled" />
    </bpmn:subProcess>

    <bpmn:sequenceFlow id="Flow_ToCheck" sourceRef="Start_BookingRequested" targetRef="Task_CheckSlot" />
    <bpmn:sequenceFlow id="Flow_ToGateway" sourceRef="Task_CheckSlot" targetRef="Gateway_SlotStatus" />
    <bpmn:sequenceFlow id="Flow_Available" name="AVAILABLE" sourceRef="Gateway_SlotStatus" targetRef="Task_BookSlot">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=slotResult.slotStatus = "AVAILABLE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Full" name="FULL" sourceRef="Gateway_SlotStatus" targetRef="Call_SendSlotFull">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=slotResult.slotStatus = "FULL"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToConfirm" sourceRef="Task_BookSlot" targetRef="Call_SendConfirmation" />
    <bpmn:sequenceFlow id="Flow_ToWait" sourceRef="Call_SendConfirmation" targetRef="Timer_WaitAppointment" />
    <bpmn:sequenceFlow id="Flow_ToCompleted" sourceRef="Timer_WaitAppointment" targetRef="End_Completed" />
    <bpmn:sequenceFlow id="Flow_ToRejected" sourceRef="Call_SendSlotFull" targetRef="End_Rejected" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_AppointmentBooking">
    <bpmndi:BPMNPlane id="Plane_AppointmentBooking" bpmnElement="appointment-booking">
      <bpmndi:BPMNShape id="Start_BookingRequested_di" bpmnElement="Start_BookingRequested">
        <dc:Bounds x="152" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="126" y="225" width="90" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckSlot_di" bpmnElement="Task_CheckSlot">
        <dc:Bounds x="240" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_SlotStatus_di" bpmnElement="Gateway_SlotStatus" isMarkerVisible="true">
        <dc:Bounds x="395" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="390" y="151" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BookSlot_di" bpmnElement="Task_BookSlot">
        <dc:Bounds x="520" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_SendConfirmation_di" bpmnElement="Call_SendConfirmation">
        <dc:Bounds x="670" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_WaitAppointment_di" bpmnElement="Timer_WaitAppointment">
        <dc:Bounds x="822" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="800" y="225" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Completed_di" bpmnElement="End_Completed">
        <dc:Bounds x="922" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="900" y="225" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_SendSlotFull_di" bpmnElement="Call_SendSlotFull">
        <dc:Bounds x="520" y="290" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rejected_di" bpmnElement="End_Rejected">
        <dc:Bounds x="672" y="312" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="645" y="355" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EventSub_HandleCancellation_di" bpmnElement="EventSub_HandleCancellation" isExpanded="true">
        <dc:Bounds x="240" y="430" width="520" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_CancelReceived_di" bpmnElement="Start_CancelReceived">
        <dc:Bounds x="282" y="502" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="260" y="545" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReleaseSlot_di" bpmnElement="Task_ReleaseSlot">
        <dc:Bounds x="370" y="480" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_SendCancellation_di" bpmnElement="Call_SendCancellation">
        <dc:Bounds x="530" y="480" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Cancelled_di" bpmnElement="End_Cancelled">
        <dc:Bounds x="682" y="502" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="656" y="545" width="90" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToCheck_di" bpmnElement="Flow_ToCheck">
        <di:waypoint x="188" y="200" /><di:waypoint x="240" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToGateway_di" bpmnElement="Flow_ToGateway">
        <di:waypoint x="340" y="200" /><di:waypoint x="395" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Available_di" bpmnElement="Flow_Available">
        <di:waypoint x="445" y="200" /><di:waypoint x="520" y="200" />
        <bpmndi:BPMNLabel><dc:Bounds x="450" y="182" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Full_di" bpmnElement="Flow_Full">
        <di:waypoint x="420" y="225" /><di:waypoint x="420" y="330" /><di:waypoint x="520" y="330" />
        <bpmndi:BPMNLabel><dc:Bounds x="430" y="312" width="30" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToConfirm_di" bpmnElement="Flow_ToConfirm">
        <di:waypoint x="620" y="200" /><di:waypoint x="670" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToWait_di" bpmnElement="Flow_ToWait">
        <di:waypoint x="770" y="200" /><di:waypoint x="822" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToCompleted_di" bpmnElement="Flow_ToCompleted">
        <di:waypoint x="858" y="200" /><di:waypoint x="922" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToRejected_di" bpmnElement="Flow_ToRejected">
        <di:waypoint x="620" y="330" /><di:waypoint x="672" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToRelease_di" bpmnElement="Flow_ToRelease">
        <di:waypoint x="318" y="520" /><di:waypoint x="370" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToCancelNotify_di" bpmnElement="Flow_ToCancelNotify">
        <di:waypoint x="470" y="520" /><di:waypoint x="530" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToCancelled_di" bpmnElement="Flow_ToCancelled">
        <di:waypoint x="630" y="520" /><di:waypoint x="682" y="520" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>