<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_outpass"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="hostel-outpass" name="Hostel Out-Pass Request" isExecutable="true">

    <bpmn:startEvent id="StartEvent_requested" name="Out-pass requested">
      <bpmn:outgoing>Flow_start_check</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_check" name="Check request">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-outpass" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_check</bpmn:incoming>
      <bpmn:outgoing>Flow_check_gw</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_route" name="Valid? Nights?" default="Flow_reject">
      <bpmn:incoming>Flow_check_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_auto</bpmn:outgoing>
      <bpmn:outgoing>Flow_warden</bpmn:outgoing>
      <bpmn:outgoing>Flow_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_warden" name="Warden approval">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="warden-approval-form" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_warden</bpmn:incoming>
      <bpmn:outgoing>Flow_warden_merge</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_merge">
      <bpmn:incoming>Flow_auto</bpmn:incoming>
      <bpmn:incoming>Flow_warden_merge</bpmn:incoming>
      <bpmn:incoming>Flow_reject</bpmn:incoming>
      <bpmn:outgoing>Flow_merge_issue</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_issue" name="Issue out-pass">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="issue-outpass" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_merge_issue</bpmn:incoming>
      <bpmn:outgoing>Flow_issue_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_done" name="Done">
      <bpmn:incoming>Flow_issue_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_start_check" sourceRef="StartEvent_requested" targetRef="Task_check" />
    <bpmn:sequenceFlow id="Flow_check_gw" sourceRef="Task_check" targetRef="Gateway_route" />

    <bpmn:sequenceFlow id="Flow_auto" name="day out (nights = 0)" sourceRef="Gateway_route" targetRef="Gateway_merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=valid and nights = 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_warden" name="nights &gt;= 1" sourceRef="Gateway_route" targetRef="Task_warden">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=valid and nights &gt;= 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_reject" name="invalid dates" sourceRef="Gateway_route" targetRef="Gateway_merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(valid)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_warden_merge" sourceRef="Task_warden" targetRef="Gateway_merge" />
    <bpmn:sequenceFlow id="Flow_merge_issue" sourceRef="Gateway_merge" targetRef="Task_issue" />
    <bpmn:sequenceFlow id="Flow_issue_end" sourceRef="Task_issue" targetRef="EndEvent_done" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="hostel-outpass">
      <bpmndi:BPMNShape id="Shape_start" bpmnElement="StartEvent_requested">
        <dc:Bounds x="152" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="130" y="225" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_check" bpmnElement="Task_check">
        <dc:Bounds x="240" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_gw" bpmnElement="Gateway_route" isMarkerVisible="true">
        <dc:Bounds x="395" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="383" y="232" width="75" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_warden" bpmnElement="Task_warden">
        <dc:Bounds x="520" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_merge" bpmnElement="Gateway_merge" isMarkerVisible="true">
        <dc:Bounds x="715" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_issue" bpmnElement="Task_issue">
        <dc:Bounds x="800" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_end" bpmnElement="EndEvent_done">
        <dc:Bounds x="962" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="968" y="225" width="26" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_start_check" bpmnElement="Flow_start_check">
        <di:waypoint x="188" y="200" /><di:waypoint x="240" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_check_gw" bpmnElement="Flow_check_gw">
        <di:waypoint x="340" y="200" /><di:waypoint x="395" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_auto" bpmnElement="Flow_auto">
        <di:waypoint x="420" y="175" /><di:waypoint x="420" y="80" />
        <di:waypoint x="740" y="80" /><di:waypoint x="740" y="175" />
        <bpmndi:BPMNLabel><dc:Bounds x="540" y="62" width="100" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_warden" bpmnElement="Flow_warden">
        <di:waypoint x="445" y="200" /><di:waypoint x="520" y="200" />
        <bpmndi:BPMNLabel><dc:Bounds x="456" y="182" width="55" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_reject" bpmnElement="Flow_reject">
        <di:waypoint x="420" y="225" /><di:waypoint x="420" y="320" />
        <di:waypoint x="740" y="320" /><di:waypoint x="740" y="225" />
        <bpmndi:BPMNLabel><dc:Bounds x="550" y="302" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_warden_merge" bpmnElement="Flow_warden_merge">
        <di:waypoint x="620" y="200" /><di:waypoint x="715" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_merge_issue" bpmnElement="Flow_merge_issue">
        <di:waypoint x="765" y="200" /><di:waypoint x="800" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_issue_end" bpmnElement="Flow_issue_end">
        <di:waypoint x="900" y="200" /><di:waypoint x="962" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
