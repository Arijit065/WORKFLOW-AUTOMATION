{
  "components": [
    {
      "text": "## Out-pass approval\n\n**Student:** {{studentName}} ({{regNo}})\n\n**Hostel block:** {{hostelBlock}}\n\n**Out date:** {{outDate}}\n\n**Return date:** {{returnDate}}\n\n**Nights:** {{nights}}\n\n**Parent phone:** {{parentPhone}}\n\n**Purpose:** {{purpose}}",
      "type": "text",
      "id": "Field_details"
    },
    {
      "label": "Approve this out-pass",
      "type": "checkbox",
      "id": "Field_approved",
      "key": "approved"
    },
    {
      "label": "Warden remarks",
      "type": "textarea",
      "id": "Field_remarks",
      "key": "wardenRemarks"
    }
  ],
  "type": "default",
  "id": "warden-approval-form",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.8.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.0.0"
  },
  "schemaVersion": 18
}
