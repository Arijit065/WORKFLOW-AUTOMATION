<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_JobRecruitment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:process id="Process_JobRecruitment" name="Job Applicant Recruitment Process" isExecutable="false">
    <bpmn:startEvent id="start3" name="Candidate submits job application">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="gw1" name="Meets Eligibility Criteria?">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_reject_screen" name="Rejected (Not Eligible)">
      <bpmn:incoming>f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gw2" name="Passed Technical Interview?">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_reject_tech" name="Rejected (Technical)">
      <bpmn:incoming>f10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gw3" name="Selected in HR Round?">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_reject_hr" name="Rejected (HR Round)">
      <bpmn:incoming>f14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_offer" name="Offer Letter Sent">
      <bpmn:incoming>f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start3" targetRef="t_screen" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_screen" targetRef="gw1" />
    <bpmn:sequenceFlow id="f3" name="No" sourceRef="gw1" targetRef="t_reject_screen" />
    <bpmn:sequenceFlow id="f4" name="Yes" sourceRef="gw1" targetRef="t_schedule_tech" />
    <bpmn:sequenceFlow id="f5" sourceRef="t_reject_screen" targetRef="end_reject_screen" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_schedule_tech" targetRef="t_eval_tech" />
    <bpmn:sequenceFlow id="f7" sourceRef="t_eval_tech" targetRef="gw2" />
    <bpmn:sequenceFlow id="f8" name="Fail" sourceRef="gw2" targetRef="t_reject_tech" />
    <bpmn:sequenceFlow id="f9" name="Pass" sourceRef="gw2" targetRef="t_schedule_hr" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_reject_tech" targetRef="end_reject_tech" />
    <bpmn:sequenceFlow id="f11" sourceRef="t_schedule_hr" targetRef="gw3" />
    <bpmn:sequenceFlow id="f12" name="Not Selected" sourceRef="gw3" targetRef="t_reject_hr" />
    <bpmn:sequenceFlow id="f13" name="Selected" sourceRef="gw3" targetRef="t_offer" />
    <bpmn:sequenceFlow id="f14" sourceRef="t_reject_hr" targetRef="end_reject_hr" />
    <bpmn:sequenceFlow id="f15" sourceRef="t_offer" targetRef="end_offer" />
    <bpmn:serviceTask id="t_schedule_tech" name="Schedule Technical Interview">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_reject_screen" name="Send Rejection Notification">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_schedule_hr" name="Schedule HR/Managerial Round">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_reject_tech" name="Send Rejection Notification">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_offer" name="Generate &#38; Send Offer Letter">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_reject_hr" name="Send Rejection Notification">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_screen" name="Screen Application vs Eligibility Criteria">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t_eval_tech" name="Evaluate Technical Interview Performance">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:userTask>
  </bpmn:process>
