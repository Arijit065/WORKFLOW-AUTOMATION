<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_LoanApplication" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:process id="Process_LoanApplication" name="Loan Application Processing" isExecutable="false">
    <bpmn:startEvent id="start2" name="Customer submits loan application">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="gw1" name="Documents Valid?">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_reject_doc" name="Application Rejected (Docs)">
      <bpmn:incoming>f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gw2" name="Eligible?">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_reject_elig" name="Application Rejected (Not Eligible)">
      <bpmn:incoming>f9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gw3" name="Loan Officer Approves?">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_approved" name="Loan Approved">
      <bpmn:incoming>f13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_reject_officer" name="Loan Rejected">
      <bpmn:incoming>f14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start2" targetRef="t_verify" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_verify" targetRef="gw1" />
    <bpmn:sequenceFlow id="f3" name="Invalid" sourceRef="gw1" targetRef="t_reject_doc" />
    <bpmn:sequenceFlow id="f4" name="Valid" sourceRef="gw1" targetRef="t_eligibility" />
    <bpmn:sequenceFlow id="f5" sourceRef="t_reject_doc" targetRef="end_reject_doc" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_eligibility" targetRef="gw2" />
    <bpmn:sequenceFlow id="f7" name="Not Eligible" sourceRef="gw2" targetRef="t_reject_elig" />
    <bpmn:sequenceFlow id="f8" name="Eligible" sourceRef="gw2" targetRef="t_forward" />
    <bpmn:sequenceFlow id="f9" sourceRef="t_reject_elig" targetRef="end_reject_elig" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_forward" targetRef="gw3" />
    <bpmn:sequenceFlow id="f11" name="Reject" sourceRef="gw3" targetRef="t_reject_officer" />
    <bpmn:sequenceFlow id="f12" name="Approve" sourceRef="gw3" targetRef="t_disburse" />
    <bpmn:sequenceFlow id="f13" sourceRef="t_disburse" targetRef="end_approved" />
    <bpmn:sequenceFlow id="f14" sourceRef="t_reject_officer" targetRef="end_reject_officer" />
    <bpmn:serviceTask id="t_verify" name="Verify Documents &#38; Credit Score">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_eligibility" name="Check Eligibility (Credit Score &#38; Income)">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_reject_doc" name="Reject Application &#38; Notify Customer">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_reject_elig" name="Send Rejection Notification">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_disburse" name="Disburse Loan Amount &#38; Send Approval Notification">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_reject_officer" name="Send Rejection Notification">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t_forward" name="Forward to Loan Officer for Approval">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:userTask>
  </bpmn:process>
