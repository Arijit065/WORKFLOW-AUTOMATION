<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_HotelReservation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:process id="Process_HotelReservation" name="Hotel Room Reservation Process" isExecutable="false">
    <bpmn:startEvent id="start1" name="Guest submits booking request (check-in/out dates)">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="gw1" name="Rooms Available?">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>Flow_0jg42il</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_noroom" name="No Rooms Available">
      <bpmn:incoming>f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gw2" name="Payment Successful?">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:outgoing>Flow_01m3xlu</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_payfail" name="Payment Failed">
      <bpmn:incoming>f9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_success" name="Booking Confirmed">
      <bpmn:incoming>f11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start1" targetRef="t_check" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_check" targetRef="gw1" />
    <bpmn:sequenceFlow id="f4" name="Yes" sourceRef="gw1" targetRef="t_payment" />
    <bpmn:sequenceFlow id="f5" sourceRef="t_noroom" targetRef="end_noroom" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_payment" targetRef="gw2" />
    <bpmn:sequenceFlow id="f8" name="Yes" sourceRef="gw2" targetRef="t_confirm" />
    <bpmn:sequenceFlow id="f9" sourceRef="t_payfail" targetRef="end_payfail" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_confirm" targetRef="t_email" />
    <bpmn:sequenceFlow id="f11" sourceRef="t_email" targetRef="end_success" />
    <bpmn:sequenceFlow id="Flow_0jg42il" sourceRef="gw1" targetRef="t_noroom" />
    <bpmn:sequenceFlow id="Flow_01m3xlu" sourceRef="gw2" targetRef="t_payfail" />
    <bpmn:userTask id="t_check" name="Check Room Availability">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_noroom" name="Notify Guest: No Rooms Available">
      <bpmn:incoming>Flow_0jg42il</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_payfail" name="Notify Guest: Payment Failed">
      <bpmn:incoming>Flow_01m3xlu</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_confirm" name="Confirm Booking &#38; Generate Reference No.">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t_payment" name="Request Payment (Deposit)">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_email" name="Send Booking Confirmation Email">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
