<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Purchase" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_PurchaseOrder" name="Online Purchase Order Processing" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Customer places order">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_CheckAvailability" name="Check product availability">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Available" name="Product available?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Available</bpmn:outgoing>
      <bpmn:outgoing>Flow_OutOfStock</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_OutOfStock" name="Notify customer: out of stock">
      <bpmn:incoming>Flow_OutOfStock</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndOutOfStock</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_OutOfStock" name="Order ended - out of stock">
      <bpmn:incoming>Flow_ToEndOutOfStock</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_ProcessPayment" name="Process payment">
      <bpmn:incoming>Flow_Available</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_PaymentOK" name="Payment successful?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentOK</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentFail</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_PaymentFail" name="Notify customer: payment failed">
      <bpmn:incoming>Flow_PaymentFail</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndPaymentFail</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_PaymentFail" name="Order ended - payment failed">
      <bpmn:incoming>Flow_ToEndPaymentFail</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_ConfirmOrder" name="Confirm order">
      <bpmn:incoming>Flow_PaymentOK</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PrepareShipment" name="Prepare product for shipment">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ShipOrder" name="Ship order">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ShippingConfirmation" name="Send shipping confirmation to customer">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndShipped</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Shipped" name="Order completed">
      <bpmn:incoming>Flow_ToEndShipped</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_CheckAvailability" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CheckAvailability" targetRef="Gateway_Available" />
    <bpmn:sequenceFlow id="Flow_Available" name="Available" sourceRef="Gateway_Available" targetRef="Task_ProcessPayment" />
    <bpmn:sequenceFlow id="Flow_OutOfStock" name="Unavailable" sourceRef="Gateway_Available" targetRef="Task_OutOfStock" />
    <bpmn:sequenceFlow id="Flow_ToEndOutOfStock" sourceRef="Task_OutOfStock" targetRef="EndEvent_OutOfStock" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ProcessPayment" targetRef="Gateway_PaymentOK" />
    <bpmn:sequenceFlow id="Flow_PaymentOK" name="Success" sourceRef="Gateway_PaymentOK" targetRef="Task_ConfirmOrder" />
    <bpmn:sequenceFlow id="Flow_PaymentFail" name="Failed" sourceRef="Gateway_PaymentOK" targetRef="Task_PaymentFail" />
    <bpmn:sequenceFlow id="Flow_ToEndPaymentFail" sourceRef="Task_PaymentFail" targetRef="EndEvent_PaymentFail" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ConfirmOrder" targetRef="Task_PrepareShipment" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_PrepareShipment" targetRef="Task_ShipOrder" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ShipOrder" targetRef="Task_ShippingConfirmation" />
    <bpmn:sequenceFlow id="Flow_ToEndShipped" sourceRef="Task_ShippingConfirmation" targetRef="EndEvent_Shipped" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_PurchaseOrder">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <omgdc:Bounds x="152" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel><omgdc:Bounds x="128" y="285" width="86" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckAvailability_di" bpmnElement="Task_CheckAvailability">
        <omgdc:Bounds x="240" y="220" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Available_di" bpmnElement="Gateway_Available" isMarkerVisible="true">
        <omgdc:Bounds x="405" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel><omgdc:Bounds x="385" y="292" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OutOfStock_di" bpmnElement="Task_OutOfStock">
        <omgdc:Bounds x="380" y="380" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_OutOfStock_di" bpmnElement="EndEvent_OutOfStock">
        <omgdc:Bounds x="552" y="402" width="36" height="36" />
        <bpmndi:BPMNLabel><omgdc:Bounds x="525" y="445" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ProcessPayment_di" bpmnElement="Task_ProcessPayment">
        <omgdc:Bounds x="510" y="220" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PaymentOK_di" bpmnElement="Gateway_PaymentOK" isMarkerVisible="true">
        <omgdc:Bounds x="675" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel><omgdc:Bounds x="655" y="292" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PaymentFail_di" bpmnElement="Task_PaymentFail">
        <omgdc:Bounds x="650" y="380" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_PaymentFail_di" bpmnElement="EndEvent_PaymentFail">
        <omgdc:Bounds x="822" y="402" width="36" height="36" />
        <bpmndi:BPMNLabel><omgdc:Bounds x="795" y="445" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConfirmOrder_di" bpmnElement="Task_ConfirmOrder">
        <omgdc:Bounds x="780" y="220" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PrepareShipment_di" bpmnElement="Task_PrepareShipment">
        <omgdc:Bounds x="950" y="220" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ShipOrder_di" bpmnElement="Task_ShipOrder">
        <omgdc:Bounds x="1120" y="220" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ShippingConfirmation_di" bpmnElement="Task_ShippingConfirmation">
        <omgdc:Bounds x="1290" y="220" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Shipped_di" bpmnElement="EndEvent_Shipped">
        <omgdc:Bounds x="1462" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel><omgdc:Bounds x="1440" y="285" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><omgdi:waypoint x="188" y="260" /><omgdi:waypoint x="240" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><omgdi:waypoint x="350" y="260" /><omgdi:waypoint x="405" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Available_di" bpmnElement="Flow_Available">
        <omgdi:waypoint x="455" y="260" /><omgdi:waypoint x="510" y="260" />
        <bpmndi:BPMNLabel><omgdc:Bounds x="460" y="242" width="50" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_OutOfStock_di" bpmnElement="Flow_OutOfStock">
        <omgdi:waypoint x="430" y="285" /><omgdi:waypoint x="430" y="380" />
        <bpmndi:BPMNLabel><omgdc:Bounds x="436" y="330" width="55" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEndOutOfStock_di" bpmnElement="Flow_ToEndOutOfStock"><omgdi:waypoint x="500" y="420" /><omgdi:waypoint x="552" y="420" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><omgdi:waypoint x="620" y="260" /><omgdi:waypoint x="675" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PaymentOK_di" bpmnElement="Flow_PaymentOK">
        <omgdi:waypoint x="725" y="260" /><omgdi:waypoint x="780" y="260" />
        <bpmndi:BPMNLabel><omgdc:Bounds x="730" y="242" width="50" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PaymentFail_di" bpmnElement="Flow_PaymentFail">
        <omgdi:waypoint x="700" y="285" /><omgdi:waypoint x="700" y="380" />
        <bpmndi:BPMNLabel><omgdc:Bounds x="706" y="330" width="40" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEndPaymentFail_di" bpmnElement="Flow_ToEndPaymentFail"><omgdi:waypoint x="770" y="420" /><omgdi:waypoint x="822" y="420" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><omgdi:waypoint x="890" y="260" /><omgdi:waypoint x="950" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><omgdi:waypoint x="1060" y="260" /><omgdi:waypoint x="1120" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><omgdi:waypoint x="1230" y="260" /><omgdi:waypoint x="1290" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEndShipped_di" bpmnElement="Flow_ToEndShipped"><omgdi:waypoint x="1410" y="260" /><omgdi:waypoint x="1462" y="260" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
